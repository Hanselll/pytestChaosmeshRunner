        <mxCell id="ext-inputs" value="Extensibility&#xa;Add new case YAMLs under chaos_runner/cases.&#xa;Add config keys in config.py / config.example.yaml.&#xa;Expose options through pytest hooks or runner CLI args." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fefce8;strokeColor=#ca8a04;fontSize=11;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="55" y="520" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ext-runner" value="Extensibility&#xa;Add orchestration phases in runner.py.&#xa;Keep network/kill split behavior isolated in _phase_case and _render_phase_yaml.&#xa;Add pre/post actions via observer config instead of hardcoding case-specific steps." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="335" y="520" width="240" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ext-factory" value="Extensibility&#xa;Add finder names in case_schema.KNOWN_FINDERS and targets.resolve_targets.&#xa;Add renderer modules and register them with @register(...).&#xa;For modular_chaos, add @fault_builder(&quot;new_type&quot;) and include it in MODULAR_FAULT_TYPES." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="650" y="520" width="285" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ext-exec" value="Extensibility&#xa;Add execution backends behind run_workflow().&#xa;remote_apply is selected by config.EXECUTION_MODE.&#xa;Keep apply/delete/upload details inside tools.k8s and tools.remote." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=11;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1010" y="520" width="225" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ext-cluster" value="Extensibility&#xa;New Chaos Mesh kinds require a renderer/builder plus schema validation.&#xa;Selectors should stay resolved through target ids or labels.&#xa;Network verification can be extended per Chaos kind/action." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=11;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1278" y="520" width="175" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ext-artifacts" value="Extensibility&#xa;Add new log sections in observer.py.&#xa;Add LMT commands via config or case observer.lmt.&#xa;Keep generated artifacts deterministic: YAML paths, fixed json mirror, and structured result dict." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=11;fontColor=#111827;" vertex="1" parent="1">
