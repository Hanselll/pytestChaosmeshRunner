{
  "name": "bgp_info_create_and_compare",
  "description": "Create a BGP config from web UI, compare queried web row with database snapshot row, then clean up.",
  "defaults": {
    "network_element": "10.230.4.248",
    "db": {
      "host": "127.0.0.1",
      "port": 55432,
      "user": "postgres",
      "password": "Mecdev_2023",
      "database": "db_upf",
      "schema": "ems_upf",
      "psql_path": "C:\\Program Files\\PostgreSQL\\14\\bin\\psql.exe",
      "source": "config_snapshot",
      "array_key": "upfBgpInfoConf"
    }
  },
  "variables": {
    "remote_ip": "198.18.0.101",
    "vrf_id": "777",
    "remote_as": "65001",
    "ippool_name": "auto_bgp_pool_9102",
    "ipv4_pool": "172.31.102.0/27",
    "ipv6_pool": "FC04::172:31:102:0/112"
  },
  "setup": [
    {
      "id": "delete_bgp_before",
      "action": "config-write",
      "continue_on_failure": true,
      "task": {
        "path_by_name": ["业务开通配置", "BGP配置", "BGP配置", "删除BGP配置(DEL UPFBGPINFOCONF)"],
        "params": {
          "远端通信IP": "${variables.remote_ip}",
          "VRF ID": "${variables.vrf_id}"
        },
        "submit": true
      }
    },
    {
      "id": "delete_bgp_pool_before",
      "action": "config-write",
      "continue_on_failure": true,
      "task": {
        "path_by_name": ["业务开通配置", "BGP配置", "BGP本地IP地址池配置", "删除BGP本地IP地址池配置(DEL UPFBGPLOCALIPPOOLCONF)"],
        "params": { "地址池名称": "${variables.ippool_name}" },
        "submit": true
      }
    }
  ],
  "steps": [
    {
      "id": "create_bgp_local_ippool",
      "action": "config-write",
      "task": {
        "path_by_name": ["业务开通配置", "BGP配置", "BGP本地IP地址池配置", "增加BGP本地IP地址池配置(ADD UPFBGPLOCALIPPOOLCONF)"],
        "params": {
          "地址池名称": "${variables.ippool_name}",
          "ipv4地址池": "${variables.ipv4_pool}",
          "ipv6地址池": "${variables.ipv6_pool}"
        },
        "submit": true
      },
      "assertions": [{ "path": "submitted", "equals": true }]
    },
    {
      "id": "create_bgp_info",
      "action": "config-write",
      "task": {
        "path_by_name": ["业务开通配置", "BGP配置", "BGP配置", "增加BGP配置(ADD UPFBGPINFOCONF)"],
        "params": {
          "远端通信IP": "${variables.remote_ip}",
          "VRF ID": "${variables.vrf_id}",
          "远端AS号": "${variables.remote_as}",
          "地址池名称": "${variables.ippool_name}"
        },
        "submit": true
      },
      "assertions": [{ "path": "submitted", "equals": true }]
    },
    {
      "id": "compare_bgp_info",
      "action": "config-generic-compare",
      "retry": { "attempts": 4, "interval_seconds": 5 },
      "task": {
        "path_by_name": ["业务开通配置", "BGP配置", "BGP配置", "查询BGP配置(SHOW UPFBGPINFOCONF)"],
        "params": {
          "远端通信IP": "${variables.remote_ip}",
          "VRF ID": "${variables.vrf_id}"
        },
        "compare": {
          "key_fields": ["远端通信IP", "VRF ID"],
          "compare_fields": ["远端通信IP", "VRF ID", "远端AS号", "地址池名称"],
          "web_to_db_field_map": {
            "远端通信IP": "remoteIp",
            "VRF ID": "vrfId",
            "远端AS号": "remoteAs",
            "地址池名称": "ippoolName"
          }
        }
      },
      "assertions": [
        { "path": "summary.compared_row_count", "equals": 1 },
        { "path": "summary.mismatch_row_count", "equals": 0 },
        { "path": "summary.all_match", "equals": true }
      ]
    }
  ],
  "teardown": [
    {
      "id": "delete_bgp_after",
      "action": "config-write",
      "continue_on_failure": true,
      "task": {
        "path_by_name": ["业务开通配置", "BGP配置", "BGP配置", "删除BGP配置(DEL UPFBGPINFOCONF)"],
        "params": {
          "远端通信IP": "${variables.remote_ip}",
          "VRF ID": "${variables.vrf_id}"
        },
        "submit": true
      }
    },
    {
      "id": "delete_bgp_pool_after",
      "action": "config-write",
      "continue_on_failure": true,
      "task": {
        "path_by_name": ["业务开通配置", "BGP配置", "BGP本地IP地址池配置", "删除BGP本地IP地址池配置(DEL UPFBGPLOCALIPPOOLCONF)"],
        "params": { "地址池名称": "${variables.ippool_name}" },
        "submit": true
      }
    }
  ]
}
